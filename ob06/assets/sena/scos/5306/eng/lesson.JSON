6aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use when you talk about local traditions in a city.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "tradition", "type": "name"}, {"content": "beliefs or customs that people follow and practice", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Chocolate Week is a true San Francisco tradition!", "type": "example"}, {"content": "engenn4le02ob06aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "factory", "type": "name"}, {"content": "a building that produces items in large quantities", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I want to visit the Giovanelli Chocolate Factory.", "type": "example"}, {"content": "engenn4le02ob06aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "stall", "type": "name"}, {"content": "a small stand or booth for the sale of products in a large area", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There are many stalls filled with all kinds of chocolate.", "type": "example"}, {"content": "engenn4le02ob06aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "brand", "type": "name"}, {"content": "the name of a company that sells goods", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Giovanelli is my favorite chocolate brand.", "type": "example"}, {"content": "engenn4le02ob06aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to sample", "type": "name"}, {"content": "to try something in small quantities", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I would like to sample different chocolate brands.", "type": "example"}, {"content": "engenn4le02ob06aud06", "type": "audio"}]}, {"type": "target_wo