{"_data": [{"contents": [{"content": "Vanessa in San Francisco", "type": "lesson_name"}, {"content": "A Sweet Tooth", "type": "unit_name"}, {"content": 7, "type": "position"}, {"content": "scholar > Delicious Food > Belgium", "type": "origin"}, {"content": 2, "type": "lesson"}, {"content": "A2.1", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": " Accurately use information about travel and vacations in social situations.", "type": "primary"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle", "type": "secondary_1"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle.", "type": "secondary_2"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle.", "type": "secondary_3"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle", "type": "secondary_4"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle.", "type": "secondary_5"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle.", "type": "secondary_6"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle", "type": "secondary_7"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": "feedback form", "type": "name"}, {"content": "a form you use to write comments or suggestions", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I need to send the feedback form to Giovanelli's.", "type": "example"}, {"content": "engenn4le02ob07aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use when you read a recipe.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "cookie", "type": "name"}, {"content": "a round biscuit, sometimes made with chocolate chips", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I have a great chocolate cookie recipe!", "type": "example"}, {"content": "engenn4le02ob07aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "cup", "type": "name"}, {"content": "a measure in the imperial system; 236 ml", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The recipe calls for 1 cup of flour.", "type": "example"}, {"content": "engenn4le02ob07aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "ounce", "type": "name"}, {"content": "a measure in the imperial system; 30 grams", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The recipe calls for 2 ounces of chocolate.", "type": "example"}, {"content": "engenn4le02ob07aud10", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "spoonful", "type": "name"}, {"content": "the content of a spoon", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Pour a spoonful of sugar in my coffee, please.", "type": "example"}, {"content": "engenn4le02ob07aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "mixture", "type": "name"}, {"content": "when all the ingredients are blended together", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Place a spoonful of the mixture on a baking tray.", "type": "example"}, {"content": "engenn4le02ob07aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content"